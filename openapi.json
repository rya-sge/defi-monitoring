    "/api/alerts": {
      "get": {
        "tags": [
          "alerts"
        ],
        "summary": "Get Alerts",
        "description": "Alerts the watcher has recorded, after a block cursor.\n\nPoll this: pass the previous `cursor` back as `since`. The cursor is a block number, the\nsame unit the watcher resumes from, so moving to a push transport later changes the\ndelivery and not the contract.",
        "operationId": "get_alerts_api_alerts_get",
        "parameters": [
          {
            "name": "target",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "From /api/targets. Omitted: the first one.",
              "title": "Target"
            },
            "description": "From /api/targets. Omitted: the first one."
          },
          {
            "name": "since",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "description": "Only alerts strictly after this block.",
              "default": 0,
              "title": "Since"
            },
            "description": "Only alerts strictly after this block."
          },
          {
            "name": "level",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "info",
                    "warn",
                    "critical"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Minimum level to return.",
              "title": "Level"
            },
            "description": "Minimum level to return."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 2000,
              "minimum": 1,
              "default": 200,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AlertPage"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
