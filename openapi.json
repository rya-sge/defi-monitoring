{
  "openapi": "3.1.0",
  "info": {
    "title": "riskdep",
    "summary": "Risk of DeFi positions on Ethereum, centred on Morpho.",
    "description": "HTTP API over `riskdep`, for the browser UI in `web/`.\n\nResponsibilities, and only these: address the artifacts, validate the inputs, serve JSON.\nNo risk logic lives here \u2014 `pipeline.analyze` computes, `report.to_dict` and `graph.to_dict`\nshape, this module routes. Adding a rule or a threshold here would be a mistake.\n\nThe watcher is deliberately **not** hosted: `python -m riskdep watch` runs as its own process\nand appends to `out/watch-*.jsonl`; `GET /api/alerts` reads those files with a block cursor.\nThat keeps one poll loop per target however many browsers are open, and lets either side\nrestart without the other.\n\nRun it with:  uv run uvicorn riskdep.api:app --reload\n",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "Health",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/graph": {
      "get": {
        "tags": [
          "graph"
        ],
        "summary": "Get Graph",
        "description": "The dependency graph. With no user and no vault, the last graph written to `out/`.\n\nThe whole graph is returned in one payload: selecting a node and walking its dependencies\nis the client's job, not an endpoint \u2014 100 nodes fit in the browser and Cytoscape traverses\nthem better than a round trip would.",
        "operationId": "get_graph_api_graph_get",
        "parameters": [
          {
            "name": "user",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Address whose positions to include; repeatable.",
              "default": [],
              "title": "User"
            },
            "description": "Address whose positions to include; repeatable."
          },
          {
            "name": "vault",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Vault V2 address to include; repeatable.",
              "default": [],
              "title": "Vault"
            },
            "description": "Vault V2 address to include; repeatable."
          },
          {
            "name": "block",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Block to read at. Omitted: 2 behind the head.",
              "title": "Block"
            },
            "description": "Block to read at. Omitted: 2 behind the head."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GraphResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
